<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- traceId 转换器：MDC 有 traceId 时输出 "[tid=xxx] " 前缀 -->
	<conversionRule conversionWord="traceId" converterClass="com.xgateai.logging.TraceIdConverter"/>

	<!-- 控制台彩色日志输出 -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss} %highlight(%-5level) %traceId%cyan(%logger{24}) - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- 控制台框式日志输出（GATEWAY_CONSOLE 专用）：msg 原样多行打印，无任何前缀 -->
	<appender name="CONSOLE_BOXED" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%msg%n</pattern>
		</encoder>
	</appender>

	<!-- 全量日志文件（滚动保留 30 天） -->
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>logs/application.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>30</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %traceId%logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- 网关业务日志文件（请求分块、调用链、故障转移，独立文件便于实时 tail） -->
	<appender name="GATEWAY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>logs/gateway.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>logs/gateway.%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>30</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss} %traceId%msg%n</pattern>
		</encoder>
	</appender>

	<!-- 网关业务专用 Logger：仅写 gateway.log，不在控制台打印单行请求日志（控制台只留框式日志） -->
	<logger name="GATEWAY" level="INFO" additivity="false">
		<appender-ref ref="GATEWAY_FILE"/>
	</logger>

	<!-- 网关框式日志 Logger：仅输出到控制台（纯 msg），不落文件 -->
	<logger name="GATEWAY_CONSOLE" level="INFO" additivity="false">
		<appender-ref ref="CONSOLE_BOXED"/>
	</logger>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="FILE"/>
	</root>
</configuration>
